{
  "name": "@vit-rin/js",
  "version": "0.1.0",
  "description": "TypeScript SDK for integrating games with VIT-RIN.",
  "license": "UNLICENSED",
  "type": "module",
  "sideEffects": false,
  "main": "./build/cjs/index.cjs",
  "module": "./build/esm/index.js",
  "types": "./build/types/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./build/types/index.d.ts",
        "default": "./build/esm/index.js"
      },
      "require": {
        "types": "./build/types/index.d.cts",
        "default": "./build/cjs/index.cjs"
      }
    },
    "./ui": {
      "import": {
        "types": "./build/types/ui/index.d.ts",
        "default": "./build/esm/ui/index.js"
      },
      "require": {
        "types": "./build/types/ui/index.d.cts",
        "default": "./build/cjs/ui.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "ui": [
        "./build/types/ui/index.d.ts"
      ]
    }
  },
  "files": [
    "build"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "rimraf build && rollup -c && node scripts/mirror-cjs-types.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "size": "size-limit",
    "check:types": "attw --pack .",
    "check:bundle": "source-map-explorer build/cjs/index.cjs --no-border-checks --html build/bundle-report.html"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@rollup/plugin-commonjs": "^28.0.1",
    "@rollup/plugin-node-resolve": "^15.3.0",
    "@rollup/plugin-terser": "^0.4.4",
    "@rollup/plugin-typescript": "^12.1.1",
    "@size-limit/file": "^11.1.6",
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "rimraf": "^6.0.1",
    "rollup": "^4.24.4",
    "rollup-plugin-dts": "^6.1.1",
    "size-limit": "^11.1.6",
    "source-map-explorer": "^2.5.3",
    "tslib": "^2.8.1",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  },
  "size-limit": [
    {
      "name": "headless core (all ESM modules)",
      "path": ["build/esm/index.js", "build/esm/core/**/*.js"],
      "limit": "10 KB"
    },
    {
      "name": "headless core (CDN IIFE)",
      "path": "build/iife/vit-rin.min.js",
      "limit": "10 KB"
    }
  ]
}
